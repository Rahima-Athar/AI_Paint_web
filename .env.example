# Supabase Configuration (Backend, Auth, Database, Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here # Server only; NEVER expose in browser client

# AI Inpainting Provider Adapter ('demo' | 'replicate' | 'stability')
IMAGE_EDITING_PROVIDER=demo
IMAGE_EDITING_API_KEY= # Server only; e.g., r8_... (Replicate) or sk-... (Stability AI)

# Application URL
APP_BASE_URL=http://localhost:3000

